---
// A score out of 5 in half steps, drawn as five trail markers.
interface Props {
  value: number;
  size?: 'sm' | 'lg';
}
const { value, size = 'sm' } = Astro.props;
const marks = [1, 2, 3, 4, 5].map((n) => (value >= n ? 'full' : value >= n - 0.5 ? 'half' : 'empty'));
const label = `Rated ${value} out of 5`;
---
<span class:list={['rating', `rating--${size}`]} role="img" aria-label={label}>
  {marks.map((m) => (
    <svg class="rating__mark" viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="10" cy="10" r="8" class="rating__ring" />
      {m === 'full' && <circle cx="10" cy="10" r="8" class="rating__fill" />}
      {m === 'half' && <path d="M10 2 A8 8 0 0 0 10 18 Z" class="rating__fill" />}
    </svg>
  ))}
  <span class="rating__num">{value}<span class="rating__of">/5</span></span>
</span>

<style>
  .rating { display: inline-flex; align-items: center; gap: 3px; }
  .rating__mark { width: 14px; height: 14px; display: block; }
  .rating--lg .rating__mark { width: 22px; height: 22px; }
  .rating--lg { gap: 5px; }
  .rating__ring { fill: var(--white); stroke: var(--ink); stroke-width: 1.5; }
  .rating__fill { fill: var(--ink); }
  .rating__num {
    margin-left: 6px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .rating--lg .rating__num { font-size: 1rem; margin-left: 10px; }
  .rating__of { color: var(--mute); }
</style>
