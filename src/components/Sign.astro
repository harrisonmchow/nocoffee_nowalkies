---
// A trackhead fingerpost: a crisp plate with a pointed end.
// Rendered as a <button> (hero selector, photo filter) or an <a>.
import Icon from './Icon.astro';

interface Props {
  name: string;
  meta?: string;
  tag?: string;
  href?: string;
  active?: boolean;
  size?: 'lg' | 'sm';
  [key: string]: unknown;
}
const { name, meta, tag, href, active = false, size = 'lg', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={['sign', `sign--${size}`, { 'is-active': active }]}
  href={href}
  type={href ? undefined : 'button'}
  aria-pressed={href ? undefined : String(active)}
  {...rest}
>
  <span class="sign__body">
    <span class="sign__name">{name}</span>
    {(meta || tag) && (
      <span class="sign__meta">
        {tag && <span class={`tag tag--${tag}`}>{tag}</span>}
        {meta && <span class="mono">{meta}</span>}
      </span>
    )}
  </span>
  <span class="sign__arrow"><Icon name="arrow-right" /></span>
  <svg class="sign__tip" viewBox="0 0 20 64" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0.5 L19 32 L0 63.5" vector-effect="non-scaling-stroke" />
  </svg>
</Tag>

<style>
  .sign {
    --plate: var(--white);
    --plate-ink: var(--ink);
    --plate-line: var(--rule);
    --tip: 20px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    width: calc(100% - var(--tip));
    margin: 0;
    padding: 14px 18px 14px 20px;
    background: var(--plate);
    color: var(--plate-ink);
    border: 1px solid var(--plate-line);
    border-right: 0;
    border-radius: 3px 0 0 3px;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 260ms var(--ease),
      color 260ms var(--ease),
      transform 260ms var(--ease);
  }
  .sign__tip {
    position: absolute;
    top: -1px;
    right: calc(var(--tip) * -1);
    width: var(--tip);
    height: calc(100% + 2px);
    overflow: visible;
  }
  .sign__tip path {
    fill: var(--plate);
    stroke: var(--plate-line);
    stroke-width: 1px;
    transition: fill 260ms var(--ease), stroke 260ms var(--ease);
  }
  .sign__body { display: grid; gap: 4px; min-width: 0; flex: 1; }
  .sign__name {
    font-family: var(--serif);
    font-size: 1.625rem;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .sign__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--mute);
    flex-wrap: wrap;
  }
  .sign__arrow {
    flex: none;
    display: grid;
    place-items: center;
    font-size: 1.1rem;
    transition: transform 260ms var(--ease);
  }
  .sign:hover { transform: translateX(4px); }
  .sign:hover .sign__arrow { transform: translateX(2px); }
  .sign:active { transform: translateX(4px) scale(0.99); }

  .sign.is-active {
    --plate: var(--ink);
    --plate-ink: var(--white);
    --plate-line: var(--ink);
  }
  .sign.is-active .sign__meta { color: var(--mute-on-ink); }

  .sign--sm { padding: 9px 12px 9px 14px; gap: 10px; --tip: 14px; }
  .sign--sm .sign__name { font-size: 1.25rem; }
  .sign--sm .sign__arrow { font-size: 0.95rem; }

  @media (max-width: 600px) {
    .sign--lg { padding: 11px 14px 11px 16px; --tip: 16px; }
    .sign--lg .sign__name { font-size: 1.375rem; }
  }
</style>
