---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { photos } from '../data/photos';
import { regions } from '../data/regions';

const standIns = photos.filter((p) => p.standIn);
const regionName = (slug: string) => regions.find((r) => r.slug === slug)?.name ?? slug;
---
<Base title="Photo credits" current="credits" description="Credits for the stand-in photography used on this site.">
  <section class="cr wrap">
    <h1>Photo credits</h1>
    <p class="cr__lede">
      Until our own photos are uploaded, this site uses openly licensed photos of the same places from Wikimedia Commons. Thanks to the photographers below.
    </p>
    <ul class="cr__list" role="list">
      {standIns.map((p) => (
        <li>
          <Image src={p.image} alt="" widths={[160]} sizes="80px" />
          <div>
            <p class="cr__title">{p.caption}</p>
            <p class="mono muted">{regionName(p.region)} · {p.credit} · {p.license}</p>
          </div>
          <a href={p.source} rel="noopener" target="_blank">Source</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .cr { padding-top: clamp(56px, 9vw, 120px); }
  .cr h1 { font-size: clamp(3rem, 8vw, 6rem); letter-spacing: -0.04em; }
  .cr__lede { margin-top: 18px; max-width: 60ch; color: var(--ink-2); }
  .cr__list { list-style: none; margin: 48px 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .cr__list li {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .cr__list img { width: 80px; height: 56px; object-fit: cover; border-radius: 4px; }
  .cr__title { font-size: 0.9375rem; }
  .cr__list a { font-size: 0.875rem; }
  @media (max-width: 600px) {
    .cr__list li { grid-template-columns: 64px 1fr; }
    .cr__list img { width: 64px; height: 48px; }
    .cr__list a { grid-column: 2; }
  }
</style>
